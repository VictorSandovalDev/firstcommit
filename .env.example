# Google Cloud OAuth 2.0 credentials
# Obtenlas en: https://console.cloud.google.com/apis/credentials
CLIENT_ID=tu_client_id
CLIENT_SECRET=tu_client_secret
REDIRECT_URI=https://tu-proyecto.vercel.app/api/callback

# Vercel Blob (se genera al agregar Blob store en Vercel dashboard)
BLOB_READ_WRITE_TOKEN=

# Cron secret (genera uno random, se configura en Vercel dashboard)
CRON_SECRET=tu_cron_secret

# ID del canal de YouTube a monitorear
CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx

# Comentario que se publicara automaticamente
COMMENT_TEXT=Excelente video! Siempre con contenido de calidad
